# Foresight Monsoon Decision Support System - Environment Variables
# SIH PS 26086

# Port and Host (configured automatically by Render or Uvicorn)
PORT=8000
HOST=0.0.0.0

# Optional LLM Advisory Keys (falls back to rule-based ICAR agronomic engine if unset)
GROQ_API_KEY=
ANTHROPIC_API_KEY=

# Optional PostgreSQL Database (falls back to local JSON file store if unset)
DATABASE_URL=
